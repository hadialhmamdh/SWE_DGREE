#lang racket/base
;; Signature: last-item(lst)
;; Purpose: returns the last item of a non-empty list
;; Pre-conditions: true (we assume that list is not empty)
;; Tests:
;; (last-item '(1 2 3)) => 3
;; (last-item '(a b c)) => 'c

(define last-item
  (lambda (lst)
    (if (null? (cdr lst))
        (car lst)
        (last-item (cdr lst)))))

;; Signature: remove-last-item(lst)
;; Purpose: returns the list without the last item
;; Pre-conditions: true (we assume that list is not empty)
;; Tests:
;; (remove-last-item '(1 2 3)) => '(1 2)
;; (remove-last-item '(a b c)) => '(a b)

(define remove-last-item
  (lambda (lst)
    (if (null? (cdr lst))
        '()
        (cons (car lst) (remove-last-item (cdr lst))))))




;; Signature: rotate-nth(lst n)
;; Purpose: rotates the list to the right n times
;; Pre-conditions: list is not empty, n >= 0 (in this question we assume that)
;; Tests:
;; (rotate-nth '(1 2 3) 1) => '(3 1 2)
;; (rotate-nth '(1 2 3) 2) => '(2 3 1)

(define rotate-nth
  (lambda (lst n)
    (if (= n 0)
        lst
        (rotate-nth (cons (last-item lst) (remove-last-item lst)) (- n 1)))))

