<Window x:Class="IntroSE.Kanban.Frontend.View.BoardList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntroSE.Kanban.Frontend.View"
        mc:Ignorable="d"
        Title="BoardList" 
        Height="550" Width="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#EDF1F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="20"
                       VerticalAlignment="Center"
                       Text="{Binding Path=WelcomeMessage, Mode=OneTime}"/>

            <Button Grid.Column="1"
                    Height="35"
                    Width="120"
                    Margin="10,0,0,0"
                    Background="#007BFF"
                    Foreground="White"
                    BorderBrush="#007BFF"
                    BorderThickness="2"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="CreateBoard_Click"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                                <Setter Property="BorderBrush" Value="#0056B3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE710;" 
                               FontSize="14"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Create Board"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Column Headers -->
        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Background="#F8F9FA"
                BorderBrush="#E1E5E9"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Board Name Header -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE81E;"
                               FontSize="14"
                               Foreground="#007BFF"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Board Name"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Owner Header -->
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE77B;"
                               FontSize="14"
                               Foreground="#007BFF"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Owner"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Actions Header -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE713;"
                               FontSize="14"
                               Foreground="#007BFF"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Actions"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Board List -->
        <ListView x:Name="BoardListView"
          Grid.Row="2"
          Margin="0,0,0,0"
          ItemsSource="{Binding Boards}"
          HorizontalContentAlignment="Stretch"
          BorderThickness="0"
          Background="Transparent">


            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#F3F2F1"/>
                    <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8F9FA"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="BorderBrush" Value="#007BFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Board Name -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE81E;"
                                       FontSize="12"
                                       Foreground="#605E5C"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#323130"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                        </StackPanel>

                        <!-- Owner -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE77B;"
                                       FontSize="12"
                                       Foreground="#605E5C"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Owner}"
                                       Foreground="#605E5C"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Owner}" />
                        </StackPanel>

                        <!-- Delete Button -->
                        <Button Grid.Column="2"
                                Height="35"
                                Width="90"
                                Margin="10,0,0,0"
                                Background="#E81123"
                                Foreground="White"
                                BorderBrush="#E81123"
                                BorderThickness="2"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Click="DeleteBoard_Click"
                                ToolTip="Delete Board"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D13438"/>
                                            <Setter Property="BorderBrush" Value="#D13438"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#B71C1C"/>
                                            <Setter Property="BorderBrush" Value="#B71C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74D;"  
                                           FontSize="12"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Delete"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Dialog Overlay -->
        <Border x:Name="CreateDialogOverlay"
                Background="#80000000"
                Visibility="Collapsed"
                Grid.RowSpan="4">
            <Grid>
                <Border Background="White"
                        Width="380"
                        Padding="30"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Create Board" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,20" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Board Name:" Margin="0,0,0,8" FontSize="14"/>
                        <TextBox x:Name="BoardNameBox" 
                                 Width="320" 
                                 Height="35" 
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding CreateBoardError, Mode=OneWay}"
                                   Foreground="Red"
                                   FontSize="14"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CreateBoardError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CreateBoardError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <!-- Create Button -->
                            <Button Width="100" Margin="0,0,10,0" 
                                    Height="35"
                                    Background="#007BFF" 
                                    Foreground="White"
                                    BorderBrush="#007BFF"
                                    BorderThickness="2"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="ConfirmCreateBoard_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0056B3"/>
                                                <Setter Property="BorderBrush" Value="#0056B3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8FB;"
                                               FontSize="14"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Create"/>
                                </StackPanel>
                            </Button>

                            <!-- Cancel Button -->
                            <Button Width="90" 
                                    Height="35"
                                    Background="White" 
                                    Foreground="#323130"
                                    BorderBrush="#D6D6D6"
                                    BorderThickness="2"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="CancelCreateBoard_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE711;"
                                               FontSize="14"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Cancel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- General Error Message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="14"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>