<Window x:Class="IntroSE.Kanban.Frontend.View.BoardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntroSE.Kanban.Frontend.View"
        mc:Ignorable="d"
        Title="Board View" 
        Height="700" Width="1200"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#EDF1F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Board Info -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E1E5E9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Board Name and Owner -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE81E;"
                               FontSize="20"
                               Foreground="#007BFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BoardName}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#323130"
                               VerticalAlignment="Center"
                               Margin="0,0,30,0"/>

                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE77B;"
                               FontSize="16"
                               Foreground="#605E5C"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Owner:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#605E5C"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding OwnerEmail}"
                               FontSize="14"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                </StackPanel>



                <!-- Members Section -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE716;"
                               FontSize="16"
                               Foreground="#007BFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Members:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#605E5C"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD"
                                        BorderBrush="#007BFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,4"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               Foreground="#007BFF"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Columns Header -->
        <Border Grid.Row="1"
                Background="#F8F9FA"
                BorderBrush="#E1E5E9"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Backlog Header -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8B7;"
                               FontSize="16"
                               Foreground="#DC3545"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Backlog"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Backlog.Tasks.Count, StringFormat='({0} tasks)'}"
                               FontSize="14"
                               Foreground="#605E5C"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                    <TextBlock FontSize="14"
                               Foreground="#DC3545"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Backlog.Limit, StringFormat='/ {0} limit'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backlog.Limit}" Value="-1">
                                        <Setter Property="Text" Value="/ No Limit"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- In Progress Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE9F3;"
                               FontSize="16"
                               Foreground="#FFC107"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="In Progress"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding InProgress.Tasks.Count, StringFormat='({0} tasks)'}"
                               FontSize="14"
                               Foreground="#605E5C"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                    <TextBlock FontSize="14"
                               Foreground="#FFC107"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding InProgress.Limit, StringFormat='/ {0} limit'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InProgress.Limit}" Value="-1">
                                        <Setter Property="Text" Value="/ No Limit"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Done Header -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE73E;"
                               FontSize="16"
                               Foreground="#28A745"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Done"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#323130"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Done.Tasks.Count, StringFormat='({0} tasks)'}"
                               FontSize="14"
                               Foreground="#605E5C"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                    <TextBlock FontSize="14"
                               Foreground="#28A745"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Done.Limit, StringFormat='/ {0}'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Done.Limit}" Value="-1">
                                        <Setter Property="Text" Value="/ No Limit"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Columns Content -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Backlog Column -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E1E5E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Backlog.Tasks}" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF"
                                        BorderBrush="#DC3545"
                                        BorderThickness="2"
                                        CornerRadius="6"
                                        Margin="0,0,0,8"
                                        Padding="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E0E0E0" BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Task Title -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#323130"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <!-- Task Description - REMOVED -->

                                        <!-- Task Details -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <!-- Assignee -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE77B;"
                                                           FontSize="10"
                                                           Foreground="#605E5C"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Assignee}"
                                                           FontSize="10"
                                                           Foreground="#605E5C"/>
                                            </StackPanel>

                                            <!-- Due Date -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE787;"
                                                           FontSize="10"
                                                           Foreground="#DC3545"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DueTime}"
                                                           FontSize="10"
                                                           Foreground="#DC3545"/>
                                            </StackPanel>

                                            <!-- Created Date -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8DF;"
                                                           FontSize="10"
                                                           Foreground="#605E5C"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CreationTime}"
                                                           FontSize="10"
                                                           Foreground="#605E5C"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- In Progress Column -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E1E5E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InProgress.Tasks}" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF"
                                        BorderBrush="#FFC107"
                                        BorderThickness="2"
                                        CornerRadius="6"
                                        Margin="0,0,0,8"
                                        Padding="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E0E0E0" BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Task Title -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#323130"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <!-- Task Description - REMOVED -->

                                        <!-- Task Details -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <!-- Assignee -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE77B;"
                                                           FontSize="10"
                                                           Foreground="#605E5C"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Assignee}"
                                                           FontSize="10"
                                                           Foreground="#605E5C"/>
                                            </StackPanel>

                                            <!-- Due Date -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE787;"
                                                           FontSize="10"
                                                           Foreground="#FFC107"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DueTime}"
                                                           FontSize="10"
                                                           Foreground="#FFC107"/>
                                            </StackPanel>

                                            <!-- Created Date -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8DF;"
                                                           FontSize="10"
                                                           Foreground="#605E5C"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CreationTime}"
                                                           FontSize="10"
                                                           Foreground="#605E5C"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Done Column -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#E1E5E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Done.Tasks}" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF"
                                        BorderBrush="#28A745"
                                        BorderThickness="2"
                                        CornerRadius="6"
                                        Margin="0,0,0,8"
                                        Padding="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E0E0E0" BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Task Title -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#323130"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <!-- Task Description - REMOVED -->

                                        <!-- Task Details -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <!-- Assignee -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE77B;"
                                                           FontSize="10"
                                                           Foreground="#605E5C"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Assignee}"
                                                           FontSize="10"
                                                           Foreground="#605E5C"/>
                                            </StackPanel>

                                            <!-- Due Date -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE787;"
                                                           FontSize="10"
                                                           Foreground="#28A745"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DueTime}"
                                                           FontSize="10"
                                                           Foreground="#28A745"/>
                                            </StackPanel>

                                            <!-- Created Date -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8DF;"
                                                           FontSize="10"
                                                           Foreground="#605E5C"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CreationTime}"
                                                           FontSize="10"
                                                           Foreground="#605E5C"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Error Message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="14"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>