<Window x:Class="IntroSE.Kanban.Frontend.View.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntroSE.Kanban.Frontend.View"
        mc:Ignorable="d"
        Title="Login"
        Height="550" Width="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#EDF1F5">
    <Grid>
        <!-- Main Content -->
        <Border CornerRadius="20" Background="White" Margin="50" Padding="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" 
                BorderBrush="#D6D6D6" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <!-- Header -->
                <TextBlock Text="Welcome to Kanban!" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,60"/>

                <!-- Login Button (Secondary) -->
                <Button Content="Login"
                        Height="50" 
                        Margin="0,15,0,20"
                        Background="White"
                        BorderBrush="#007BFF"
                        BorderThickness="2"
                        Foreground="#007BFF"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Click="ShowLoginDialog_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                    <Setter Property="BorderBrush" Value="#0056B3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Register Button (Primary) -->
                <Button Content="Create Account"
                        Height="50" 
                        Margin="0,0,0,25"
                        Background="#007BFF"
                        BorderBrush="#007BFF"
                        BorderThickness="2"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Click="ShowRegisterDialog_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0056B3"/>
                                    <Setter Property="BorderBrush" Value="#0056B3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Login Dialog Overlay -->
        <Border x:Name="LoginDialogOverlay"
                Background="#80000000"
                Visibility="Collapsed">
            <Grid>
                <Border Background="White"
                        Width="380"
                        Padding="30"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Login" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,20" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Email:" Margin="0,0,0,8" FontSize="14"/>
                        <TextBox x:Name="LoginEmailBox"
                                 Text="{Binding Email}" 
                                 Width="320" 
                                 Height="35" 
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Password:" Margin="0,0,0,8" FontSize="14"/>
                        <PasswordBox x:Name="LoginPasswordBox" 
                                     PasswordChanged="PasswordBox_PasswordChanged" 
                                     Width="320" 
                                     Height="35" 
                                     MaxLength="20"
                                     FontSize="14"
                                     Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                   Foreground="Red"
                                   FontSize="14"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Message}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <!-- Login Button -->
                            <Button Width="90" Margin="0,0,10,0" 
                                    Height="35"
                                    Background="#007BFF" 
                                    Foreground="White"
                                    BorderBrush="#007BFF"
                                    BorderThickness="2"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="Login_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0056B3"/>
                                                <Setter Property="BorderBrush" Value="#0056B3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8FB;"
                                               FontSize="14"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Login"/>
                                </StackPanel>
                            </Button>
                            <!-- Cancel Button -->
                            <Button Width="90" 
                                    Height="35"
                                    Background="White" 
                                    Foreground="#323130"
                                    BorderBrush="#D6D6D6"
                                    BorderThickness="2"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="CancelLogin_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE711;"
                                               FontSize="14"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Cancel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Register Dialog Overlay -->
        <Border x:Name="RegisterDialogOverlay"
                Background="#80000000"
                Visibility="Collapsed">
            <Grid>
                <Border Background="White"
                        Width="380"
                        Padding="30"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Create Account" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,20" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Email:" Margin="0,0,0,8" FontSize="14"/>
                        <TextBox x:Name="RegisterEmailBox"
                                 Text="{Binding Email}"
                                 Width="320" 
                                 Height="35" 
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Password:" Margin="0,0,0,8" FontSize="14"/>
                        <PasswordBox x:Name="RegisterPasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Width="320" 
                                     Height="35" 
                                     MaxLength="20"
                                     FontSize="14"
                                     Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding Message, Mode=OneWay}"
                                   Foreground="Red"
                                   FontSize="14"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Message}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <!-- Register Button -->
                            <Button Width="100" Margin="0,0,10,0" 
                                    Height="35"
                                    Background="#007BFF" 
                                    Foreground="White"
                                    BorderBrush="#007BFF"
                                    BorderThickness="2"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="Register_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0056B3"/>
                                                <Setter Property="BorderBrush" Value="#0056B3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8FB;"
                                               FontSize="14"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Register"/>
                                </StackPanel>
                            </Button>
                            <!-- Cancel Button -->
                            <Button Width="90" 
                                    Height="35"
                                    Background="White" 
                                    Foreground="#323130"
                                    BorderBrush="#D6D6D6"
                                    BorderThickness="2"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="CancelRegister_Click"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE711;"
                                               FontSize="14"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Cancel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>